# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
CODEAGENT_SESSION_SECRET=replace-with-output-of-make-env
CODEAGENT_API_KEY_PEPPER=replace-with-output-of-make-env
CODEAGENT_DEMO_PASSWORD=replace-with-output-of-make-env

# Optional: answers and patches written by a model instead of the offline local engine
# CODEAGENT_LLM_PROVIDER=ollama            # or openai: any OpenAI-compatible API
# CODEAGENT_LLM_MODEL=qwen2.5-coder:7b
# CODEAGENT_OLLAMA_URL=http://host.docker.internal:11434
# CODEAGENT_LLM_BASE_URL=https://api.openai.com/v1
# CODEAGENT_LLM_API_KEY=

# Optional: sandbox backend for test runs (auto uses Docker when the socket answers)
# CODEAGENT_SANDBOX_BACKEND=auto           # or docker, or subprocess
# CODEAGENT_DOCKER_GID=0                   # group owning /var/run/docker.sock (make up detects it)

# Optional overrides
# CODEAGENT_PRODUCT_NAME=Euron CodeAgent
# CODEAGENT_LOG_LEVEL=info
# CODEAGENT_WEB_PORT=3190
# CODEAGENT_API_PORT=8190
# CODEAGENT_PG_PORT=5459
# CODEAGENT_REDIS_PORT=6419
# CODEAGENT_FLOCI_PORT=4619
